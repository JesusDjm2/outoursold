# Evita la ejecución de scripts en esta carpeta de subidas
<FilesMatch "\.(php|php\d|phtml|pht|phar|cgi|pl|py|sh|exe)$">
    Require all denied
</FilesMatch>

# Compatibilidad con Apache 2.2 (por si el hosting usa mod_access viejo)
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|php\d|phtml|pht|phar|cgi|pl|py|sh|exe)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# SVG: ya no se aceptan como logo, pero si quedara alguno, abierto directo no ejecuta scripts.
<FilesMatch "\.svg$">
    <IfModule mod_headers.c>
        Header set Content-Security-Policy "sandbox"
    </IfModule>
</FilesMatch>
